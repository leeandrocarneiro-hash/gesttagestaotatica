{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "service-profit-hub",
      "version": "0.1.0",
      "title": "Service Profit Hub"
    },
    "tools": [
      {
        "name": "get_service_profits",
        "title": "Lucro por serviço",
        "description": "Lista cada serviço com preço, custos (materiais + despesas), lucro, valor recebido e status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_entries",
        "title": "Listar lançamentos",
        "description": "Lista os lançamentos de uma aba da planilha (Servicos, Atendimentos, Materiais, Recebimentos ou Despesas).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "tab": {
              "type": "string",
              "enum": [
                "Servicos",
                "Atendimentos",
                "Materiais",
                "Recebimentos",
                "Despesas"
              ],
              "description": "Aba a listar."
            }
          },
          "required": [
            "tab"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_entry",
        "title": "Novo lançamento",
        "description": "Adiciona um lançamento a uma aba. `values` segue a ordem dos campos: Servicos [Data agendada, Cliente, Telefone, Descrição, Status, Preço, Observações]; Atendimentos [Data, Cliente, Contato, Canal, Assunto, Observações]; Materiais [Data, ID do serviço, Material, Fornecedor, Quantidade, Custo unitário]; Recebimentos [Data, ID do serviço, Cliente, Valor, Forma de pagamento]; Despesas [Data, ID do serviço, Categoria, Descrição, Valor]. Datas em AAAA-MM-DD, números com ponto.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "tab": {
              "type": "string",
              "enum": [
                "Servicos",
                "Atendimentos",
                "Materiais",
                "Recebimentos",
                "Despesas"
              ],
              "description": "Aba de destino."
            },
            "values": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2000
              },
              "description": "Valores na ordem dos campos da aba."
            }
          },
          "required": [
            "tab",
            "values"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_service_status",
        "title": "Atualizar status do serviço",
        "description": "Muda o status de um serviço pelo ID (ex.: S-001).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 20,
              "description": "ID do serviço, ex.: S-001."
            },
            "status": {
              "type": "string",
              "enum": [
                "Agendado",
                "Em execução",
                "Concluído",
                "Cancelado"
              ],
              "description": "Novo status."
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
