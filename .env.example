# Google Sheets gateway (somente servidor; nunca use prefixo VITE_)
LOVABLE_API_KEY=
GOOGLE_SHEETS_API_KEY=

# ID da planilha CENTRAL do GESTTA: empresas, solicitações, usuários e permissões
GESTTA_CENTRAL_SPREADSHEET_ID=

# Segredo aleatório forte (mínimo 32 bytes) para assinar sessões HttpOnly
GESTTA_SESSION_SECRET=

# Primeiro administrador geral (bootstrap inicial; não é uma senha)
GESTTA_BOOTSTRAP_ADMIN_EMAIL=

# Token temporário para inicializar cabeçalhos da planilha central (remover após uso)
GESTTA_CENTRAL_SETUP_TOKEN=
