# Server-only variables. Never prefix these with VITE_.
# Google Sheets connector used to create/access each company's financial spreadsheet.
LOVABLE_API_KEY=
GOOGLE_SHEETS_API_KEY=

# Cloudflare D1 REST API: company/user registry and encrypted-secret metadata live server-side.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# At least 32 random bytes. Used to sign secure GESTTA sessions.
GESTTA_SESSION_SECRET=
